generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum AdminRole {
  OWNER
  MANAGER
  STAFF
}

enum MenuOptionType {
  ADD_ON
  REMOVAL
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum EmailStatus {
  SENT
  FAILED
}

enum WeeklyCheckoutStatus {
  PENDING
  PAID
  CANCELLED
}

enum RestaurantPlan {
  FREE
  STARTER
  GROWTH
  SCALE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  PAUSED
}

enum LocationType {
  SCHOOL
  OFFICE
}

// ─── RESTAURANT (root tenant) ─────────────────────────────────────────────────

model Restaurant {
  id                       String         @id @default(cuid())
  name                     String
  slug                     String         @unique   // subdomain: {slug}.lunchpad.us
  customDomain             String?        @unique   // e.g. lunch.example.com
  timezone                 String         @default("America/Los_Angeles")
  logoUrl                  String?
  primaryColor             String?        @default("#c41230")
  accentColor              String?        @default("#f59e0b")
  darkColor                String?        @default("#1c0505")
  heroImageUrl             String?
  heroTitleColor           String?        @default("#ffffff")
  heroAccentColor          String?        @default("#fbbf24")
  bodyTextColor            String?        @default("#1c0505")
  displayFont              String?        @default("Oswald")
  bodyFont                 String?        @default("Inter")
  contactEmail             String?
  contactPhone             String?
  isActive                 Boolean        @default(true)

  // Stripe Connect
  stripeAccountId          String?        @unique
  stripeOnboardingComplete Boolean        @default(false)

  // Subscription
  plan                     RestaurantPlan     @default(FREE)
  subscriptionStatus       SubscriptionStatus @default(TRIAL)
  trialEndsAt              DateTime?
  stripeCustomerId         String?            @unique
  stripeSubscriptionId     String?            @unique

  // Kitchen sheet automation (0–23 = UTC hour to send; null = disabled)
  kitchenSheetSendHour     Int?

  // Onboarding wizard state. Most steps detect completion from existing
  // data (locations, menu items, etc.) — these flags cover the steps that
  // don't have a natural data signature.
  operatorType             String?       // "school" | "office" | "hybrid" — seeds defaults
  onboardingComplete       Boolean       @default(false)
  testOrderPlacedAt        DateTime?     // step 8 of wizard — operator placed a test order
  onboardingShareAcked     Boolean       @default(false) // step 10 — operator confirmed they shared the URL

  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  admins                   AdminUser[]
  schools                  School[]
  menuItems                MenuItem[]
  orders                   Order[]
  weeklyCheckoutBatches    WeeklyCheckoutBatch[]
  processedWebhookEvents   ProcessedWebhookEvent[]
}

// ─── ADMIN USERS ─────────────────────────────────────────────────────────────

model AdminUser {
  id            String                     @id @default(cuid())
  restaurantId  String
  email         String
  name          String
  passwordHash  String
  role          AdminRole                  @default(MANAGER)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  restaurant    Restaurant                 @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  resetTokens   AdminPasswordResetToken[]

  @@unique([restaurantId, email])
}

// Password reset tokens. We never store the raw token — only its SHA-256
// hash — so a DB read can't recover live reset URLs. Tokens expire after
// an hour and are marked single-use via `usedAt`. Issuing a new token
// invalidates the user's previous unused tokens (handled in code).
model AdminPasswordResetToken {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

// ─── SCHOOLS (locations within a restaurant) ─────────────────────────────────

model School {
  id                   String             @id @default(cuid())
  restaurantId         String
  name                 String
  slug                 String
  locationType         LocationType       @default(SCHOOL)
  timezone             String             @default("America/Los_Angeles")
  defaultCutoffHour    Int                @default(17)
  defaultCutoffMinute  Int                @default(0)
  collectTeacher       Boolean            @default(true)
  collectClassroom     Boolean            @default(true)
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  restaurant           Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  deliveryDates        DeliveryDate[]
  menuAvailability     DeliveryMenuItem[]
  orders               Order[]
  students             Student[]
  parentChildren       ParentChild[]
  weeklyPlans          WeeklyLunchPlan[]
  weeklyCheckoutItems  WeeklyCheckoutBatchItem[]
  schoolMenuItems      SchoolMenuItem[]

  @@unique([restaurantId, slug])
}

// ─── SCHOOL MENU RESTRICTIONS ─────────────────────────────────────────────────
// When a MenuItem has at least one SchoolMenuItem row, it is ONLY available
// to schools listed here. Zero rows = available to all schools (backward compat).

model SchoolMenuItem {
  id         String   @id @default(cuid())
  schoolId   String
  menuItemId String
  createdAt  DateTime @default(now())
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([schoolId, menuItemId])
}

// ─── DELIVERY DATES ──────────────────────────────────────────────────────────

model DeliveryDate {
  id                  String               @id @default(cuid())
  schoolId            String
  deliveryDate        DateTime
  cutoffAt            DateTime
  orderingOpen        Boolean              @default(true)
  notes               String?
  // Soft-cancel for operator-initiated cancellations (snow days, school
  // closures, etc). When set, hide from parent-facing UIs and treat as
  // dead for kitchen sheets. Existing orders on this date are refunded
  // by the cancelDeliveryDate server action before this is set.
  cancelledAt         DateTime?
  cancelledReason     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  orders              Order[]
  menuAvailability    DeliveryMenuItem[]
  weeklyCheckoutItems WeeklyCheckoutBatchItem[]

  @@unique([schoolId, deliveryDate])
}

// ─── MENU ─────────────────────────────────────────────────────────────────────

model MenuItem {
  id                  String             @id @default(cuid())
  restaurantId        String
  name                String
  slug                String
  description         String?
  imageUrl            String?
  basePriceCents      Int
  isActive            Boolean            @default(true)
  // Structured dietary tags — surfaced as filter chips on the parent
  // ordering page and as a rollup on the kitchen sheet. Free-form so
  // operators can add their own (e.g. "halal", "gluten-free", "spicy").
  dietaryTags         String[]           @default([])
  // User-defined category. NULL = uncategorized. We keep the field a
  // simple string (rather than a Category model) so bulk Excel uploads
  // and AI categorization can write any value without prior setup.
  category            String?
  sortOrder           Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  restaurant          Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  options             MenuOption[]
  orderItems          OrderItem[]
  availability        DeliveryMenuItem[]
  weeklyPlans         WeeklyLunchPlan[]
  weeklyCheckoutItems WeeklyCheckoutBatchItem[]
  schoolRestrictions  SchoolMenuItem[]   // empty = available to all schools

  @@unique([restaurantId, slug])
}

model DeliveryMenuItem {
  id             String       @id @default(cuid())
  deliveryDateId String
  menuItemId     String
  schoolId       String
  isAvailable    Boolean      @default(true)
  maxQuantity    Int?         // null = unlimited; set to cap orders for this item on this date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deliveryDate   DeliveryDate @relation(fields: [deliveryDateId], references: [id], onDelete: Cascade)
  menuItem       MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([deliveryDateId, menuItemId])
}

model MenuOption {
  id              String         @id @default(cuid())
  menuItemId      String
  name            String
  optionType      MenuOptionType
  priceDeltaCents Int            @default(0)
  isDefault       Boolean        @default(false)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  menuItem        MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

// ─── STUDENTS & PARENTS ───────────────────────────────────────────────────────

model Student {
  id           String   @id @default(cuid())
  schoolId     String
  studentName  String
  grade        String
  teacherName  String?
  classroom    String?
  allergyNotes String?
  dietaryNotes String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  orders       Order[]
}

// ParentUser is global — one account works across restaurants.
// Their children are scoped to schools (which belong to restaurants).
model ParentUser {
  id                    String                @id @default(cuid())
  email                 String                @unique
  name                  String?
  image                 String?
  provider              String?
  providerId            String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  children              ParentChild[]
  orders                Order[]
  weeklyPlans           WeeklyLunchPlan[]
  weeklyCheckoutBatches WeeklyCheckoutBatch[]
}

model ParentChild {
  id                  String                  @id @default(cuid())
  parentUserId        String
  schoolId            String
  studentName         String
  grade               String
  teacherName         String?
  classroom           String?
  allergyNotes        String?
  dietaryNotes        String?
  archivedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  parentUser          ParentUser              @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  school              School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  orders              Order[]
  weeklyPlans         WeeklyLunchPlan[]
  weeklyCheckoutItems WeeklyCheckoutBatchItem[]
}

// ─── WEEKLY PLANS ─────────────────────────────────────────────────────────────

model WeeklyLunchPlan {
  id            String     @id @default(cuid())
  parentUserId  String
  parentChildId String
  schoolId      String
  weekday       Int
  menuItemId    String
  choice        String?
  additions     String[]
  removals      String[]
  sortOrder     Int        @default(0)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  parentUser    ParentUser  @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  parentChild   ParentChild @relation(fields: [parentChildId], references: [id], onDelete: Cascade)
  school        School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  menuItem      MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([parentUserId, weekday])
  @@index([parentChildId, weekday, sortOrder])
}

model WeeklyCheckoutBatch {
  id                String               @id @default(cuid())
  parentUserId      String
  restaurantId      String
  status            WeeklyCheckoutStatus @default(PENDING)
  checkoutSessionId String?              @unique
  paymentIntentId   String?              @unique
  totalCents        Int
  paidAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  parentUser        ParentUser           @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  restaurant        Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  items             WeeklyCheckoutBatchItem[]
}

model WeeklyCheckoutBatchItem {
  id                    String              @id @default(cuid())
  weeklyCheckoutBatchId String
  parentChildId         String
  schoolId              String
  deliveryDateId        String
  menuItemId            String
  choice                String?
  additions             String[]
  removals              String[]
  itemNameSnapshot      String
  basePriceCents        Int
  lineTotalCents        Int
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  weeklyCheckoutBatch   WeeklyCheckoutBatch @relation(fields: [weeklyCheckoutBatchId], references: [id], onDelete: Cascade)
  parentChild           ParentChild         @relation(fields: [parentChildId], references: [id], onDelete: Restrict)
  school                School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  deliveryDate          DeliveryDate        @relation(fields: [deliveryDateId], references: [id], onDelete: Restrict)
  menuItem              MenuItem            @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
}

// ─── ORDERS ───────────────────────────────────────────────────────────────────

model Order {
  id                  String       @id @default(cuid())
  orderNumber         String       @unique
  restaurantId        String
  schoolId            String
  deliveryDateId      String
  studentId           String
  parentUserId        String?
  parentChildId       String?
  parentName          String
  parentEmail         String
  specialInstructions String?
  subtotalCents       Int
  totalCents          Int
  currency            String       @default("usd")
  status              OrderStatus  @default(PENDING)
  paidAt              DateTime?
  refundedAt          DateTime?
  cancelledAt         DateTime?
  archivedAt          DateTime?
  confirmationSentAt  DateTime?
  checkoutSessionId   String?      @unique
  paymentIntentId     String?      @unique
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  restaurant          Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  school              School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  deliveryDate        DeliveryDate @relation(fields: [deliveryDateId], references: [id], onDelete: Restrict)
  student             Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  parentUser          ParentUser?  @relation(fields: [parentUserId], references: [id], onDelete: SetNull)
  parentChild         ParentChild? @relation(fields: [parentChildId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payment             Payment?
  emailLogs           EmailLog[]
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  menuItemId          String
  itemNameSnapshot    String
  basePriceCents      Int
  additions           String[]
  removals            String[]
  allergyNotes        String?
  dietaryNotes        String?
  specialInstructions String?
  lineTotalCents      Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem            MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String        @unique
  provider              String        @default("stripe")
  providerSessionId     String?       @unique
  providerPaymentIntent String?       @unique
  amountCents           Int
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  paidAt                DateTime?
  refundedAt            DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ─── EMAIL & WEBHOOKS ─────────────────────────────────────────────────────────

model EmailLog {
  id           String      @id @default(cuid())
  orderId      String
  emailType    String
  recipient    String
  providerId   String?
  status       EmailStatus
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ProcessedWebhookEvent {
  id           String      @id @default(cuid())
  restaurantId String?
  provider     String
  eventId      String      @unique
  eventType    String
  processedAt  DateTime    @default(now())
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
}

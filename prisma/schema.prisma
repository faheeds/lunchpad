generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── ENUMS ────────────────────────────────────────────────────────────────────

enum AdminRole {
  OWNER
  MANAGER
  STAFF
}

enum MenuOptionType {
  ADD_ON
  REMOVAL
}

enum OrderStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum EmailStatus {
  SENT
  FAILED
}

enum WeeklyCheckoutStatus {
  PENDING
  PAID
  CANCELLED
}

enum RestaurantPlan {
  FREE
  STARTER
  GROWTH
  SCALE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  PAUSED
}

enum LocationType {
  SCHOOL
  OFFICE
}

// ─── RESTAURANT (root tenant) ─────────────────────────────────────────────────

model Restaurant {
  id                       String         @id @default(cuid())
  name                     String
  slug                     String         @unique   // subdomain: {slug}.lunchpad.us
  customDomain             String?        @unique   // e.g. lunch.example.com
  timezone                 String         @default("America/Los_Angeles")
  logoUrl                  String?
  primaryColor             String?        @default("#c41230")
  accentColor              String?        @default("#f59e0b")
  darkColor                String?        @default("#1c0505")
  heroImageUrl             String?
  heroTitleColor           String?        @default("#ffffff")
  heroAccentColor          String?        @default("#fbbf24")
  bodyTextColor            String?        @default("#1c0505")
  displayFont              String?        @default("Oswald")
  bodyFont                 String?        @default("Inter")
  contactEmail             String?
  contactPhone             String?
  isActive                 Boolean        @default(true)

  // Stripe Connect
  stripeAccountId          String?        @unique
  stripeOnboardingComplete Boolean        @default(false)

  // Subscription
  plan                     RestaurantPlan     @default(FREE)
  subscriptionStatus       SubscriptionStatus @default(TRIAL)
  trialEndsAt              DateTime?
  stripeCustomerId         String?            @unique
  stripeSubscriptionId     String?            @unique

  // Kitchen sheet automation (0–23 = UTC hour to send; null = disabled)
  kitchenSheetSendHour     Int?

  // Onboarding wizard state. Most steps detect completion from existing
  // data (locations, menu items, etc.) — these flags cover the steps that
  // don't have a natural data signature.
  operatorType             String?       // "school" | "office" | "hybrid" — seeds defaults
  onboardingComplete       Boolean       @default(false)
  testOrderPlacedAt        DateTime?     // step 8 of wizard — operator placed a test order
  onboardingShareAcked     Boolean       @default(false) // step 10 — operator confirmed they shared the URL

  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  admins                   AdminUser[]
  adminInvites             AdminInvite[]
  schools                  School[]
  menuItems                MenuItem[]
  orders                   Order[]
  parentUsers              ParentUser[]
  weeklyCheckoutBatches    WeeklyCheckoutBatch[]
  processedWebhookEvents   ProcessedWebhookEvent[]
  activityLogs             ActivityLog[]
  discounts                Discount[]
}

// ─── ADMIN USERS ─────────────────────────────────────────────────────────────

model AdminUser {
  id            String                     @id @default(cuid())
  restaurantId  String
  email         String
  name          String
  passwordHash  String
  role          AdminRole                  @default(MANAGER)
  // Updated on every successful sign-in. Surfaced on the team page so
  // owners can see who's still actively using their dashboard. Nullable
  // until first login (existing rows backfill to null until they sign in).
  lastActiveAt  DateTime?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  restaurant    Restaurant                 @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  resetTokens   AdminPasswordResetToken[]
  invitesSent   AdminInvite[]              @relation("InvitesSent")
  invitesAccepted AdminInvite[]            @relation("InvitesAccepted")
  ordersCreated Order[]                    @relation("AdminCreatedOrders")
  activityLogs  ActivityLog[]

  @@unique([restaurantId, email])
}

// Magic-link invitations to join an admin team. The owner (or a manager,
// scoped down to their own role) creates the invite; the invitee gets an
// email with a single-use link, follows it, and lands on a page that lets
// them set their own name + password to create their AdminUser row.
//
// We store only a SHA-256 hash of the token, never the raw value. Tokens
// expire 14 days after creation and become single-use once acceptedAt is
// set.
model AdminInvite {
  id              String     @id @default(cuid())
  restaurantId    String
  email           String     // who the invite was sent to (lowercased)
  name            String?    // pre-filled name; invitee can override
  role            AdminRole
  invitedById     String
  tokenHash       String     @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  acceptedAdminId String?    @unique
  revokedAt       DateTime?  // owner cancelled the invite before acceptance
  createdAt       DateTime   @default(now())

  restaurant      Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  invitedBy       AdminUser  @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Restrict)
  acceptedBy      AdminUser? @relation("InvitesAccepted", fields: [acceptedAdminId], references: [id], onDelete: SetNull)

  @@index([restaurantId, email])
  @@index([restaurantId, acceptedAt, revokedAt])
}

// Password reset tokens. We never store the raw token — only its SHA-256
// hash — so a DB read can't recover live reset URLs. Tokens expire after
// an hour and are marked single-use via `usedAt`. Issuing a new token
// invalidates the user's previous unused tokens (handled in code).
model AdminPasswordResetToken {
  id          String    @id @default(cuid())
  adminUserId String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

// ─── SCHOOLS (locations within a restaurant) ─────────────────────────────────

model School {
  id                   String             @id @default(cuid())
  restaurantId         String
  name                 String
  slug                 String
  locationType         LocationType       @default(SCHOOL)
  timezone             String             @default("America/Los_Angeles")
  defaultCutoffHour    Int                @default(17)
  defaultCutoffMinute  Int                @default(0)
  collectTeacher       Boolean            @default(true)
  collectClassroom     Boolean            @default(true)
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  restaurant           Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  deliveryDates        DeliveryDate[]
  menuAvailability     DeliveryMenuItem[]
  orders               Order[]
  students             Student[]
  parentChildren       ParentChild[]
  weeklyPlans          WeeklyLunchPlan[]
  weeklyCheckoutItems  WeeklyCheckoutBatchItem[]
  schoolMenuItems      SchoolMenuItem[]

  @@unique([restaurantId, slug])
}

// ─── SCHOOL MENU RESTRICTIONS ─────────────────────────────────────────────────
// When a MenuItem has at least one SchoolMenuItem row, it is ONLY available
// to schools listed here. Zero rows = available to all schools (backward compat).

model SchoolMenuItem {
  id         String   @id @default(cuid())
  schoolId   String
  menuItemId String
  createdAt  DateTime @default(now())
  school     School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([schoolId, menuItemId])
}

// ─── DELIVERY DATES ──────────────────────────────────────────────────────────

model DeliveryDate {
  id                  String               @id @default(cuid())
  schoolId            String
  deliveryDate        DateTime
  cutoffAt            DateTime
  orderingOpen        Boolean              @default(true)
  notes               String?
  // Soft-cancel for operator-initiated cancellations (snow days, school
  // closures, etc). When set, hide from parent-facing UIs and treat as
  // dead for kitchen sheets. Existing orders on this date are refunded
  // by the cancelDeliveryDate server action before this is set.
  cancelledAt         DateTime?
  cancelledReason     String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  orders              Order[]
  menuAvailability    DeliveryMenuItem[]
  weeklyCheckoutItems WeeklyCheckoutBatchItem[]

  @@unique([schoolId, deliveryDate])
}

// ─── MENU ─────────────────────────────────────────────────────────────────────

model MenuItem {
  id                  String             @id @default(cuid())
  restaurantId        String
  name                String
  slug                String
  description         String?
  imageUrl            String?
  basePriceCents      Int
  isActive            Boolean            @default(true)
  // Structured dietary tags — surfaced as filter chips on the parent
  // ordering page and as a rollup on the kitchen sheet. Free-form so
  // operators can add their own (e.g. "halal", "gluten-free", "spicy").
  dietaryTags         String[]           @default([])
  // User-defined category. NULL = uncategorized. We keep the field a
  // simple string (rather than a Category model) so bulk Excel uploads
  // and AI categorization can write any value without prior setup.
  category            String?
  // Required top-level choices the customer must pick exactly one of
  // (e.g. for "Build Your Own Burger": Beef / Chicken / Vegan). These
  // are conceptually different from MenuOption add-ons/removals — they
  // gate the order and become part of the OrderItem.choice field.
  // Empty array = no required choice. Operators populate via the admin
  // menu item editor. Legacy items without a value fall back to a
  // hardcoded map (see lib/menu-config.ts) for backward compatibility.
  requiredChoices     String[]           @default([])
  sortOrder           Int                @default(0)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  restaurant          Restaurant         @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  options             MenuOption[]
  orderItems          OrderItem[]
  availability        DeliveryMenuItem[]
  weeklyPlans         WeeklyLunchPlan[]
  weeklyCheckoutItems WeeklyCheckoutBatchItem[]
  schoolRestrictions  SchoolMenuItem[]   // empty = available to all schools

  @@unique([restaurantId, slug])
}

model DeliveryMenuItem {
  id             String       @id @default(cuid())
  deliveryDateId String
  menuItemId     String
  schoolId       String
  isAvailable    Boolean      @default(true)
  maxQuantity    Int?         // null = unlimited; set to cap orders for this item on this date
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deliveryDate   DeliveryDate @relation(fields: [deliveryDateId], references: [id], onDelete: Cascade)
  menuItem       MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([deliveryDateId, menuItemId])
}

model MenuOption {
  id              String         @id @default(cuid())
  menuItemId      String
  name            String
  optionType      MenuOptionType
  priceDeltaCents Int            @default(0)
  isDefault       Boolean        @default(false)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  menuItem        MenuItem       @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
}

// ─── STUDENTS & PARENTS ───────────────────────────────────────────────────────

model Student {
  id           String   @id @default(cuid())
  schoolId     String
  studentName  String
  grade        String
  teacherName  String?
  classroom    String?
  allergyNotes String?
  dietaryNotes String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  orders       Order[]
}

// ParentUser is global — one account works across restaurants.
// Their children are scoped to schools (which belong to restaurants).
// Parent (customer) accounts are scoped per-tenant. The same email may
// exist as separate ParentUser records at different restaurants — each is
// fully isolated (its own children, orders, weekly plans). Without this
// scoping, signing in with the same Google account at a different
// restaurant would surface the previous restaurant's data.
model ParentUser {
  id                    String                @id @default(cuid())
  restaurantId          String
  email                 String
  name                  String?
  image                 String?
  provider              String?
  providerId            String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  restaurant            Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  children              ParentChild[]
  orders                Order[]
  weeklyPlans           WeeklyLunchPlan[]
  weeklyCheckoutBatches WeeklyCheckoutBatch[]
  discountRedemptions   DiscountRedemption[]

  @@unique([restaurantId, email])
  @@index([email])
}

model ParentChild {
  id                  String                  @id @default(cuid())
  parentUserId        String
  schoolId            String
  studentName         String
  grade               String
  teacherName         String?
  classroom           String?
  allergyNotes        String?
  dietaryNotes        String?
  archivedAt          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  parentUser          ParentUser              @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  school              School                  @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  orders              Order[]
  weeklyPlans         WeeklyLunchPlan[]
  weeklyCheckoutItems WeeklyCheckoutBatchItem[]
}

// ─── WEEKLY PLANS ─────────────────────────────────────────────────────────────

model WeeklyLunchPlan {
  id            String     @id @default(cuid())
  parentUserId  String
  parentChildId String
  schoolId      String
  weekday       Int
  menuItemId    String
  choice        String?
  additions     String[]
  removals      String[]
  sortOrder     Int        @default(0)
  isActive      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  parentUser    ParentUser  @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  parentChild   ParentChild @relation(fields: [parentChildId], references: [id], onDelete: Cascade)
  school        School      @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  menuItem      MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([parentUserId, weekday])
  @@index([parentChildId, weekday, sortOrder])
}

model WeeklyCheckoutBatch {
  id                String               @id @default(cuid())
  parentUserId      String
  restaurantId      String
  status            WeeklyCheckoutStatus @default(PENDING)
  checkoutSessionId String?              @unique
  paymentIntentId   String?              @unique
  totalCents        Int
  paidAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  parentUser        ParentUser           @relation(fields: [parentUserId], references: [id], onDelete: Cascade)
  restaurant        Restaurant           @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  items             WeeklyCheckoutBatchItem[]
}

model WeeklyCheckoutBatchItem {
  id                    String              @id @default(cuid())
  weeklyCheckoutBatchId String
  parentChildId         String
  schoolId              String
  deliveryDateId        String
  menuItemId            String
  choice                String?
  additions             String[]
  removals              String[]
  itemNameSnapshot      String
  basePriceCents        Int
  lineTotalCents        Int
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  weeklyCheckoutBatch   WeeklyCheckoutBatch @relation(fields: [weeklyCheckoutBatchId], references: [id], onDelete: Cascade)
  parentChild           ParentChild         @relation(fields: [parentChildId], references: [id], onDelete: Restrict)
  school                School              @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  deliveryDate          DeliveryDate        @relation(fields: [deliveryDateId], references: [id], onDelete: Restrict)
  menuItem              MenuItem            @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
}

// ─── ORDERS ───────────────────────────────────────────────────────────────────

model Order {
  id                  String       @id @default(cuid())
  orderNumber         String       @unique
  restaurantId        String
  schoolId            String
  deliveryDateId      String
  studentId           String
  parentUserId        String?
  parentChildId       String?
  parentName          String
  parentEmail         String
  specialInstructions String?
  subtotalCents       Int
  /// Total dollar value (in cents) deducted by any applied discount.
  /// Denormalized off DiscountRedemption for fast list / report queries.
  /// `subtotalCents - discountCents == totalCents` (before tax/fees, which
  /// we don't currently charge). 0 = no discount.
  discountCents       Int          @default(0)
  totalCents          Int
  currency            String       @default("usd")
  status              OrderStatus  @default(PENDING)
  paidAt              DateTime?
  refundedAt          DateTime?
  cancelledAt         DateTime?
  archivedAt          DateTime?
  confirmationSentAt  DateTime?
  checkoutSessionId   String?      @unique
  paymentIntentId     String?      @unique
  /// Set when an admin records this as a comped/free order. Line items still
  /// carry their menu prices (so kitchen sheets see real items) but
  /// Payment.amountCents is 0. Reports can filter on `compedAt IS NULL` to
  /// exclude comps from revenue.
  compedAt            DateTime?
  compedReason        String?
  /// Admin who created this order via the manual order flow. Null for
  /// customer self-service orders. SetNull on admin delete so the order
  /// history survives admin churn.
  createdByAdminId    String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  restaurant          Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Restrict)
  school              School       @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  deliveryDate        DeliveryDate @relation(fields: [deliveryDateId], references: [id], onDelete: Restrict)
  student             Student      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  parentUser          ParentUser?  @relation(fields: [parentUserId], references: [id], onDelete: SetNull)
  parentChild         ParentChild? @relation(fields: [parentChildId], references: [id], onDelete: SetNull)
  createdByAdmin      AdminUser?   @relation("AdminCreatedOrders", fields: [createdByAdminId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  payment             Payment?
  emailLogs           EmailLog[]
  discountRedemption  DiscountRedemption?
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  menuItemId          String
  itemNameSnapshot    String
  basePriceCents      Int
  additions           String[]
  removals            String[]
  allergyNotes        String?
  dietaryNotes        String?
  specialInstructions String?
  lineTotalCents      Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem            MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
}

model Payment {
  id                    String        @id @default(cuid())
  orderId               String        @unique
  /// "stripe" | "stripe_checkout_link" | "manual" | "comped" — extends as
  /// new payment paths are added. The customer-facing flow always uses
  /// "stripe"; admin-created orders may use any of the others.
  provider              String        @default("stripe")
  providerSessionId     String?       @unique
  providerPaymentIntent String?       @unique
  amountCents           Int
  currency              String        @default("usd")
  status                PaymentStatus @default(PENDING)
  paidAt                DateTime?
  refundedAt            DateTime?
  /// For manual payments: "cash" | "check" | "venmo" | "zelle" | "other".
  /// Free-form so operators can record whatever method makes sense without
  /// being boxed in by an enum. Null for Stripe / comped / unspecified.
  method                String?
  /// Operator notes — e.g. "Check #1234", "Cash, exact change", "Comped:
  /// replaced burnt order". Surfaced only in admin views.
  notes                 String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  order                 Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ─── EMAIL & WEBHOOKS ─────────────────────────────────────────────────────────

model EmailLog {
  id           String      @id @default(cuid())
  orderId      String
  emailType    String
  recipient    String
  providerId   String?
  status       EmailStatus
  errorMessage String?
  sentAt       DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ProcessedWebhookEvent {
  id           String      @id @default(cuid())
  restaurantId String?
  provider     String
  eventId      String      @unique
  eventType    String
  processedAt  DateTime    @default(now())
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: SetNull)
}

// ─── ACTIVITY LOG ─────────────────────────────────────────────────────────────
// Single audit-trail model that powers both the per-order timeline and the
// restaurant-wide change log. Every meaningful mutation (order created,
// order paid, menu item updated, team invite sent, etc.) writes one row here.
//
// Actor:
//   - adminUserId set → an admin did this
//   - parentUserId set → a customer did this (e.g. self-cancel)
//   - both null → system event (Stripe webhook, scheduled job)
//
// `entityType` + `entityId` index a specific record so the order detail
// page can query "everything that happened to this order." `action`
// describes what happened in machine-readable form; `summary` is the
// human-readable line shown in the UI; `metadata` is freeform JSON for
// before/after diffs or other context.

model ActivityLog {
  id            String      @id @default(cuid())
  restaurantId  String
  adminUserId   String?
  parentUserId  String?
  /// "ORDER" | "MENU_ITEM" | "DELIVERY_DATE" | "SCHOOL" | "RESTAURANT_SETTINGS"
  /// | "TEAM_MEMBER" | "ADMIN_INVITE" | "WEEKLY_BATCH". Free-form so we can
  /// add new types without migrating the enum.
  entityType    String
  entityId      String
  /// "CREATED" | "UPDATED" | "DELETED" | "PAID" | "REFUNDED" | "CANCELLED"
  /// | "ARCHIVED" | "UNARCHIVED" | "MODIFIED" | "COMPED" | "INVITED"
  /// | "INVITE_ACCEPTED" | "INVITE_REVOKED" | "ROLE_CHANGED" | "REMOVED"
  /// | "PASSWORD_CHANGED" | "PASSWORD_RESET" | "LOGGED_IN".
  action        String
  /// One-line human description for UI display, e.g.
  /// "Created order SL-20260509-1234 for $13.99 (Bacon Cheddar)".
  summary       String
  /// Optional JSON blob — typically { from, to } for diffs, or
  /// { method: "cash", reference: "Check #1234" } for context.
  metadata      Json?
  createdAt     DateTime    @default(now())

  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  adminUser     AdminUser?  @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  // Indexes ordered by the most common access pattern. Plain ASC indexes
  // work fine for our DESC ordering in queries — Postgres can scan either
  // direction. Keeping the index syntax simple avoids version-specific
  // Prisma quirks.
  @@index([restaurantId, createdAt])
  @@index([restaurantId, entityType, entityId, createdAt])
  @@index([restaurantId, adminUserId, createdAt])
}

// ─── DISCOUNTS ───────────────────────────────────────────────────────────────
//
// One unified model expresses every discount type the platform supports
// (welcome offers, promo codes, sibling discounts, day-of-week deals,
// volume thresholds, item-level discounts, BOGO, bundles). The
// `templateKind` discriminator drives which builder UI opens when an
// operator edits a discount, but the field set is the same across all
// templates — empty / null fields just mean "rule doesn't apply".
//
// Loyalty is intentionally NOT modelled here (separate concern: needs
// per-customer spend/redemption tracking + customer-facing progress).
// It'll get its own model in a later phase.
//
// Stacking rule: only the single highest-value discount auto-applies
// per order unless `allowStackingWithCode = true`. Promo codes always
// override auto-discounts. Enforced in lib/discounts.ts, not in schema.

model Discount {
  id                    String              @id @default(cuid())
  restaurantId          String

  // Operator-facing identity
  name                  String              // "Welcome offer", "Sibling discount"
  description           String?             // free-text internal notes

  // Which builder template created this — drives admin UX,
  // doesn't change runtime behavior.
  templateKind          DiscountTemplate    @default(CUSTOM)

  // Customer entry. Null = automatic (no code, applies when eligible).
  // Non-null = customer types this exact string at checkout.
  code                  String?

  // What it does
  kind                  DiscountKind        // PERCENT | FIXED_AMOUNT
  value                 Int                 // 10 (=10%) or 500 (=$5 in cents)

  // What it applies to
  scope                 DiscountScope       @default(ORDER)
  // ORDER scope: discount applies to whole-order subtotal.
  // ITEMS scope: discount applies only to matching line items
  //   (intersection of itemIds + categories — both empty = all items;
  //   one populated = restrict to that set).
  itemIds               String[]            @default([])
  categories            String[]            @default([])

  // Eligibility — all optional, all AND'd together at check time
  minOrderCents         Int?                // floor on subtotal (after item-scoping)
  minItemCount          Int?                // minimum cart-line count (sibling discount uses 2)
  firstOrderOnly        Boolean             @default(false)
  schoolIds             String[]            @default([])   // empty = all schools
  weekdays              Int[]               @default([])   // ISO 1..7, empty = all days
  startsAt              DateTime?
  endsAt                DateTime?

  // Limits
  maxRedemptionsTotal   Int?                // null = unlimited
  maxRedemptionsPerUser Int?                @default(1)
  currentRedemptions    Int                 @default(0)

  // Stacking. Defaults are conservative — operators opt into stacking
  // explicitly per discount.
  allowStackingWithCode Boolean             @default(false)

  // Special hardcoded behaviors. For BOGO we need a "free item" rule
  // that doesn't fit the percent/amount model cleanly. Encoded here so
  // we don't need yet another column when we add it in slice 3.
  // bogoBuyItemIds / bogoGetItemIds drive that — empty in slice 1.
  bogoBuyItemIds        String[]            @default([])
  bogoGetItemIds        String[]            @default([])

  isActive              Boolean             @default(true)
  createdByAdminId      String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  restaurant            Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  redemptions           DiscountRedemption[]

  // Code must be unique per tenant when present (null codes can repeat —
  // multiple automatic discounts coexist). Postgres treats NULL as distinct
  // by default so this @@unique works as expected.
  @@unique([restaurantId, code])
  @@index([restaurantId, isActive])
}

// Records every time a discount was actually applied to an order.
// One-to-one with Order in v1 (each order has at most one redemption)
// — when we add stacking we'll relax the @unique on orderId. Survives
// the discount being edited / deleted because amountCents is a snapshot
// of what was actually credited at order time.
model DiscountRedemption {
  id              String      @id @default(cuid())
  discountId      String
  orderId         String      @unique
  parentUserId    String?
  amountCents     Int         // snapshot of $ deducted
  appliedAt       DateTime    @default(now())

  discount        Discount    @relation(fields: [discountId], references: [id], onDelete: Cascade)
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  parentUser      ParentUser? @relation(fields: [parentUserId], references: [id], onDelete: SetNull)

  @@index([discountId])
  @@index([parentUserId])
}

enum DiscountTemplate {
  WELCOME
  PROMO_CODE
  SIBLING
  DAY_OF_WEEK
  VOLUME
  ITEM_DISCOUNT
  BOGO
  BUNDLE
  CUSTOM
}

enum DiscountKind {
  PERCENT
  FIXED_AMOUNT
}

enum DiscountScope {
  ORDER
  ITEMS
}

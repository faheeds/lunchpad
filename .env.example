# ─────────────────────────────────────────────
# LunchPad — Environment Variables
# Copy this file to .env.local and fill in values
# ─────────────────────────────────────────────

# Database (create a NEW Neon project at neon.tech)
DATABASE_URL=postgresql://neondb_owner:npg_il6fpoquBDs4@ep-round-mountain-akuueikt-pooler.c-3.us-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Auth (generate with: openssl rand -base64 32)
NEXTAUTH_URL=https://app.lunchpad.us
NEXTAUTH_SECRET=

# Google OAuth (create NEW credentials at console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple Sign In (reuse or create new at developer.apple.com)
AUTH_APPLE_ID=
AUTH_APPLE_SECRET=

# Stripe (create NEW account or use test keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Email via Resend (create NEW API key at resend.com)
RESEND_API_KEY=
EMAIL_FROM=noreply@lunchpad.us
EMAIL_FROM_NAME=LunchPad

# Anthropic (for AI theme suggestions — get key at console.anthropic.com)
ANTHROPIC_API_KEY=

# Vercel Cron Jobs (generate with: openssl rand -base64 32)
CRON_SECRET=

# Admin MFA / TOTP secret encryption key — 32 bytes (64 hex chars).
# Optional in phase 1 (foundation only, no runtime path uses it yet).
# Required once MFA enrollment / login enforcement ships.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=

# App
APP_BASE_URL=https://app.lunchpad.us
DEFAULT_TIMEZONE=America/Los_Angeles
